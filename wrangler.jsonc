{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "all-pack-website",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-18",
  "compatibility_flags": ["nodejs_compat"],
  // Keep variables and secrets added in the Cloudflare dashboard (admin ID and password) when a new version deploys.
  "keep_vars": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    // Admin panel storage: enquiries, saved content and uploaded pictures. Created automatically on first deploy.
    { "binding": "DB", "database_name": "all-pack-cms" }
  ],
  "observability": {
    "enabled": true
  }
}
