# Public values only. Set them in Cloudflare → Workers → all-pack-website → Settings → Variables.
# Never commit a filled-in .env file.

# Canonical site URL (canonical links, sitemap, social previews)
NEXT_PUBLIC_SITE_URL=https://allpackpk.com

# Contact (built-in defaults are used when these are empty)
NEXT_PUBLIC_PHONE=0321-8444590
NEXT_PUBLIC_WHATSAPP_NUMBER=923218444590
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_LINKEDIN_URL=

# Cloudflare Web Analytics site token (cookie-free). Leave empty to turn analytics off.
NEXT_PUBLIC_CF_ANALYTICS_TOKEN=
